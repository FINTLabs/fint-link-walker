{
  "uid": "link-walker-domain-integrity",
  "title": "Link-Walker Domain Integrity",
  "tags": [
    "link-walker"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 0,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Environment",
        "type": "custom",
        "query": "beta : aks-beta-prometheus, api : aks-api-prometheus, local : prometheus",
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "current": {
          "selected": true,
          "text": "beta",
          "value": "aks-beta-prometheus"
        },
        "options": [
          {
            "selected": true,
            "text": "beta",
            "value": "aks-beta-prometheus"
          },
          {
            "selected": false,
            "text": "api",
            "value": "aks-api-prometheus"
          },
          {
            "selected": false,
            "text": "local",
            "value": "prometheus"
          }
        ]
      },
      {
        "name": "orgId",
        "label": "Org",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(link_walker_links_count{orgId!~\"$exclude\"}, orgId)",
          "refId": "orgId"
        },
        "definition": "label_values(link_walker_links_count{orgId!~\"$exclude\"}, orgId)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "current": {},
        "options": []
      },
      {
        "name": "exclude",
        "label": "Exclude orgs",
        "description": "Regex of orgIds to leave out of the org list and every panel, for example novari.no|fintlabs.no. Empty excludes nothing.",
        "type": "textbox",
        "query": "",
        "hide": 0,
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        },
        "options": [
          {
            "selected": false,
            "text": "",
            "value": ""
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Within domain integrity",
      "description": "Share of checked links that are correct, for links whose target is in the same domain as the resource they come from (for example utdanning to utdanning). This is what the domain's own adapter is responsible for. Under All the sums span every org, so large orgs weigh more than small ones.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "clamp(100 * (1 - (sum (link_walker_link_errors{orgId=~\"$orgId\", orgId!~\"$exclude\", scope=\"within_domain\"}) or vector(0)) / (sum (link_walker_links_count{orgId=~\"$orgId\", orgId!~\"$exclude\", scope=\"within_domain\"}) > 0)), 0, 100)",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cross domain integrity",
      "description": "Share of checked links that are correct, for links that point into another domain (for example utdanning to felles). Getting these right depends on two source systems agreeing on ids. Under All the sums span every org, so large orgs weigh more than small ones.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "clamp(100 * (1 - (sum (link_walker_link_errors{orgId=~\"$orgId\", orgId!~\"$exclude\", scope=\"cross_domain\"}) or vector(0)) / (sum (link_walker_links_count{orgId=~\"$orgId\", orgId!~\"$exclude\", scope=\"cross_domain\"}) > 0)), 0, 100)",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          },
          "decimals": 2,
          "noValue": "No cross domain links"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Coverage",
      "description": "Share of all links the scan could check. The rest point to resources the scan did not fetch (not in the scan, no access, or no data), so nobody knows whether they are right. They are left out of both integrity numbers. See the Not covered table.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 5,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "clamp(100 * (sum (link_walker_links_count{orgId=~\"$orgId\", orgId!~\"$exclude\", scope!=\"not_covered\"}) or vector(0)) / (sum (link_walker_links_count{orgId=~\"$orgId\", orgId!~\"$exclude\"}) > 0), 0, 100)",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 90
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Links not covered",
      "description": "Links that point to resources the scan did not fetch. Not errors, just not checked.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 5,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(link_walker_links_count{orgId=~\"$orgId\", orgId!~\"$exclude\", scope=\"not_covered\"}) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Time since last scan",
      "description": "Age of the oldest latest scan among the selected orgs.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "topk(1, time() - max by (orgId) (link_walker_last_scan_timestamp_seconds{orgId=~\"$orgId\", orgId!~\"$exclude\"}))",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 43200
              },
              {
                "color": "red",
                "value": 86400
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Per org",
      "description": "One row per org, worst within domain integrity first. A blank cross domain integrity means the org has no checked links into another domain.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "clamp(100 * (1 - (sum by (orgId) (link_walker_link_errors{orgId=~\"$orgId\", orgId!~\"$exclude\", scope=\"within_domain\"}) or sum by (orgId) (link_walker_links_count{orgId=~\"$orgId\", orgId!~\"$exclude\", scope=\"within_domain\"}) * 0) / (sum by (orgId) (link_walker_links_count{orgId=~\"$orgId\", orgId!~\"$exclude\", scope=\"within_domain\"}) > 0)), 0, 100)",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": ""
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "clamp(100 * (1 - (sum by (orgId) (link_walker_link_errors{orgId=~\"$orgId\", orgId!~\"$exclude\", scope=\"cross_domain\"}) or sum by (orgId) (link_walker_links_count{orgId=~\"$orgId\", orgId!~\"$exclude\", scope=\"cross_domain\"}) * 0) / (sum by (orgId) (link_walker_links_count{orgId=~\"$orgId\", orgId!~\"$exclude\", scope=\"cross_domain\"}) > 0)), 0, 100)",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": ""
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C",
          "expr": "clamp(100 * (sum by (orgId) (link_walker_links_count{orgId=~\"$orgId\", orgId!~\"$exclude\", scope!=\"not_covered\"}) or sum by (orgId) (link_walker_links_count{orgId=~\"$orgId\", orgId!~\"$exclude\"}) * 0) / (sum by (orgId) (link_walker_links_count{orgId=~\"$orgId\", orgId!~\"$exclude\"}) > 0), 0, 100)",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": ""
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "D",
          "expr": "sum by (orgId) (link_walker_link_errors{orgId=~\"$orgId\", orgId!~\"$exclude\", scope=\"within_domain\"}) or sum by (orgId) (link_walker_links_count{orgId=~\"$orgId\", orgId!~\"$exclude\"}) * 0",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": ""
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "E",
          "expr": "sum by (orgId) (link_walker_link_errors{orgId=~\"$orgId\", orgId!~\"$exclude\", scope=\"cross_domain\"}) or sum by (orgId) (link_walker_links_count{orgId=~\"$orgId\", orgId!~\"$exclude\"}) * 0",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": ""
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "F",
          "expr": "sum by (orgId) (link_walker_links_count{orgId=~\"$orgId\", orgId!~\"$exclude\", scope=\"not_covered\"}) or sum by (orgId) (link_walker_links_count{orgId=~\"$orgId\", orgId!~\"$exclude\"}) * 0",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": ""
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "G",
          "expr": "time() - max by (orgId) (link_walker_last_scan_timestamp_seconds{orgId=~\"$orgId\", orgId!~\"$exclude\"})",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "orgId",
            "mode": "outer"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(orgId|Value #[A-G])$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "orgId": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6,
              "Value #G": 7
            },
            "renameByName": {
              "orgId": "Org",
              "Value #A": "Within domain",
              "Value #B": "Cross domain",
              "Value #C": "Coverage",
              "Value #D": "Errors within",
              "Value #E": "Errors cross",
              "Value #F": "Not covered",
              "Value #G": "Since last scan"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "Within domain",
            "desc": false
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Within domain"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
