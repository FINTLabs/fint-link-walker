    {
      "id": 7,
      "type": "table",
      "title": "Not covered: where the unchecked links point",
      "description": "Links from each component to a component whose resources the scan did not fetch, largest first. Scanning the target component (if the org has access and data) turns these into checked links.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (orgId, component, target_component) (link_walker_links_count{orgId=~\"$orgId\", orgId!~\"$exclude\", scope=\"not_covered\"})",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(orgId|component|target_component|Value)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "orgId": 0,
              "component": 1,
              "target_component": 2,
              "Value": 3
            },
            "renameByName": {
              "orgId": "Org",
              "component": "From component",
              "target_component": "To component",
              "Value": "Links"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "Links",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Cross domain: from → to",
      "description": "Links from one domain into another, by component pair. Errors here usually mean two source systems disagree on ids, or a code list is missing values.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
