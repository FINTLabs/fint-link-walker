{
  "uid": "link-walker-org-overview",
  "title": "Link-Walker Org Overview",
  "tags": [
    "link-walker"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 0,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Environment",
        "type": "custom",
        "query": "beta : aks-beta-prometheus, api : aks-api-prometheus, local : prometheus",
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "current": {
          "selected": true,
          "text": "beta",
          "value": "aks-beta-prometheus"
        },
        "options": [
          {
            "selected": true,
            "text": "beta",
            "value": "aks-beta-prometheus"
          },
          {
            "selected": false,
            "text": "api",
            "value": "aks-api-prometheus"
          },
          {
            "selected": false,
            "text": "local",
            "value": "prometheus"
          }
        ]
      },
      {
        "name": "orgId",
        "label": "Org",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(link_walker_last_scan_timestamp_seconds{orgId!~\"$exclude\"}, orgId)",
          "refId": "orgId"
        },
        "definition": "label_values(link_walker_last_scan_timestamp_seconds{orgId!~\"$exclude\"}, orgId)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "current": {},
        "options": []
      },
      {
        "name": "exclude",
        "label": "Exclude orgs",
        "description": "Regex of orgIds to leave out of the org list and every panel, for example novari.no|fintlabs.no. Empty excludes nothing.",
        "type": "textbox",
        "query": "",
        "hide": 0,
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        },
        "options": [
          {
            "selected": false,
            "text": "",
            "value": ""
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Link integrity",
      "description": "100 * (1 - broken links / links scanned) from the latest scan, all problem types. Under All the sums span every org, so large orgs weigh more than small ones.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "clamp(100 * (1 - (sum(link_walker_broken_links{orgId=~\"$orgId\", orgId!~\"$exclude\"}) or vector(0)) / (sum(link_walker_refs_count{orgId=~\"$orgId\", orgId!~\"$exclude\"}) > 0)), 0, 100)",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Autorelation integrity",
      "description": "Same formula counting only missing back-links that core-consumer's auto-relation rules should have created. Same denominator as Link integrity, so the loss here plus the adapter loss is the overall loss.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "clamp(100 * (1 - (sum(link_walker_broken_links{orgId=~\"$orgId\", orgId!~\"$exclude\", problem_type=\"missing-back-link-autorelation\"}) or vector(0)) / (sum(link_walker_refs_count{orgId=~\"$orgId\", orgId!~\"$exclude\"}) > 0)), 0, 100)",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Adapter integrity",
      "description": "Same formula counting only adapter problems: missing-resource, unknown-link and missing-back-link-adapter. These go back to the data supplier.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "clamp(100 * (1 - (sum(link_walker_broken_links{orgId=~\"$orgId\", orgId!~\"$exclude\", problem_type!=\"missing-back-link-autorelation\"}) or vector(0)) / (sum(link_walker_refs_count{orgId=~\"$orgId\", orgId!~\"$exclude\"}) > 0)), 0, 100)",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Time since last scan",
      "description": "Scans run every 6 hours. Yellow after 7 hours, red after 13 hours (two missed runs). Shows the org with the oldest scan and its name, so under All you can see which org is stale.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "topk(1, time() - max by (orgId) (link_walker_last_scan_timestamp_seconds{orgId=~\"$orgId\", orgId!~\"$exclude\"}))",
          "legendFormat": "{{orgId}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 25200
              },
              {
                "color": "red",
                "value": 46800
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Auto-relation problems",
      "description": "Missing back-links that core-consumer's auto-relation rules should have created.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(link_walker_broken_links{orgId=~\"$orgId\", orgId!~\"$exclude\", problem_type=\"missing-back-link-autorelation\"}) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
