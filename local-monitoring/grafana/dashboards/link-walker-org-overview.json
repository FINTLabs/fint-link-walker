          },
          "refId": "A",
          "expr": "sum(link_walker_broken_links{orgId=~\"$orgId\", orgId!~\"$exclude\", problem_type!=\"missing-back-link-autorelation\"}) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
