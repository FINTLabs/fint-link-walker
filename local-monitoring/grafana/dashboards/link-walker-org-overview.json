    {
      "id": 9,
      "type": "table",
      "title": "Per org",
      "description": "One row per org in the selected environment, worst integrity first. An org whose latest scan found no links shows a blank integrity but still shows when it was last scanned.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "clamp(100 * (1 - (sum by (orgId) (link_walker_broken_links{orgId=~\"$orgId\", orgId!~\"$exclude\"}) or sum by (orgId) (link_walker_refs_count{orgId=~\"$orgId\", orgId!~\"$exclude\"}) * 0) / (sum by (orgId) (link_walker_refs_count{orgId=~\"$orgId\", orgId!~\"$exclude\"}) > 0)), 0, 100)",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": ""
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "sum by (orgId) (link_walker_broken_links{orgId=~\"$orgId\", orgId!~\"$exclude\", problem_type=\"missing-back-link-autorelation\"}) or sum by (orgId) (link_walker_refs_count{orgId=~\"$orgId\", orgId!~\"$exclude\"}) * 0",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": ""
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C",
          "expr": "sum by (orgId) (link_walker_broken_links{orgId=~\"$orgId\", orgId!~\"$exclude\", problem_type!=\"missing-back-link-autorelation\"}) or sum by (orgId) (link_walker_refs_count{orgId=~\"$orgId\", orgId!~\"$exclude\"}) * 0",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": ""
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "D",
          "expr": "sum by (orgId) (link_walker_records_count{orgId=~\"$orgId\", orgId!~\"$exclude\"})",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": ""
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "E",
          "expr": "sum by (orgId) (link_walker_refs_count{orgId=~\"$orgId\", orgId!~\"$exclude\"})",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": ""
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "F",
          "expr": "time() - max by (orgId) (link_walker_last_scan_timestamp_seconds{orgId=~\"$orgId\", orgId!~\"$exclude\"})",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "orgId",
            "mode": "outer"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(orgId|Value #[A-F])$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "orgId": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6
            },
            "renameByName": {
              "orgId": "Org",
              "Value #A": "Integrity",
              "Value #B": "Autorelation problems",
              "Value #C": "Adapter problems",
              "Value #D": "Records",
              "Value #E": "Links",
              "Value #F": "Since last scan"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
