# Local-dev configuration for the scanner and reader. Copy to .env.local
# and adjust. Real .env.local files are git-ignored.
#
# Run with:
#   set -a; source .env.local; set +a; go run ./scanner/cmd/scanner
#
# Or one-shot:
#   env $(grep -v '^#' .env.local | xargs) go run ./scanner/cmd/scanner

# --- Required ---

# Tenant org id. Used to look up the FLAIS-stored client and label every
# row in the report. Accepts dashes, underscores, or dots — they're
# normalized internally.
ORG_ID=afk-no

# Comma-separated list of components to scan, in kebab-case (matches the
# names in metamodel.json). The scanner crawls every hovedklasse type
# in each listed component. The same list bounds what permissions a
# newly-created FLAIS client gets.
COMPONENTS=utdanning-elev,utdanning-vurdering,utdanning-utdanningsprogram,utdanning-timeplan,utdanning-kodeverk

# --- Local-dev overrides ---

# FLAIS gateway. In-cluster default points at the k8s service; for local
# dev port-forward and override here.
#   kubectl port-forward -n flais-io svc/fint-customer-objects-gateway 64130:8080
FLAIS_GATEWAY_URL=http://localhost:64130

# --- Optional (defaults usually fine) ---

# Postgres DSN. Default targets the docker-compose Postgres at the repo
# root (linkwalker/linkwalker on localhost:5432).
# DATABASE_URL=postgres://linkwalker:linkwalker@localhost:5432/linkwalker?sslmode=disable

# IdP token endpoint. Default is the prod IdP.
# IDP_URL=https://idp.felleskomponent.no/nidp/oauth/nam/token

# FINT consumer API base URL.
# BASE_URL=https://api.felleskomponent.no

# HTTP timeout for FLAIS / IdP / FINT calls.
# HTTP_TIMEOUT=60s

# Records per paginated FINT API request. Smaller pages = more requests
# but smaller payloads each; bigger pages = fewer requests but each is
# slower. 10000 is a balanced default.
# PAGE_SIZE=10000

# Log level: debug | info | warn | error. Debug surfaces per-page
# fetch / extract timings.
# LOG_LEVEL=info

# Reader bind address.
# READER_ADDR=:8080
